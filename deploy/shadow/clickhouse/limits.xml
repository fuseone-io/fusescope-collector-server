<!-- Keeps clickhouse-shadow within its container limit, as the demo's
     clickhouse/config.d/zz-limits.xml does for the demo's: small caches, no
     system logs but query_log. -->
<clickhouse>
    <max_server_memory_usage>2100000000</max_server_memory_usage>
    <max_concurrent_queries>20</max_concurrent_queries>
    <mark_cache_size>134217728</mark_cache_size>
    <uncompressed_cache_size>67108864</uncompressed_cache_size>
    <index_mark_cache_size>33554432</index_mark_cache_size>
    <index_uncompressed_cache_size>33554432</index_uncompressed_cache_size>
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </query_log>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <latency_log remove="1"/>
    <query_metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <processors_profile_log remove="1"/>
    <part_log remove="1"/>
    <error_log remove="1"/>
    <session_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
</clickhouse>
